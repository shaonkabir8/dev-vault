# Dev Vault gitignore
#
# The previous file was GitHub Pages/Jekyll boilerplate (a leftover from the
# repository template) with no Jekyll usage in the repository; it was replaced
# by this minimal, actually-applicable set.

# Environment secrets — templates (*.example) are tracked, real values never
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# Logs, temp, OS/editor clutter
*.log
.tmp/
temp/
.DS_Store
Thumbs.db
.vscode/
.idea/
